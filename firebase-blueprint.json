{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "A portfolio project item",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" },
        "image": { "type": "string" },
        "category": { "type": "string" },
        "alt": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["name", "url", "image", "category"]
    },
    "SiteContent": {
      "title": "Site Content",
      "description": "Global or section-specific site content",
      "type": "object",
      "properties": {
        "heroTitle": { "type": "string" },
        "heroSubtitle": { "type": "string" },
        "heroImages": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "Lead": {
      "title": "Lead",
      "description": "A lead captured via the chatbot or contact form",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "businessName": { "type": "string" },
        "websiteType": { "type": "string" },
        "email": { "type": "string" },
        "projectDescription": { "type": "string" },
        "timestamp": { "type": "string" },
        "source": { "type": "string", "enum": ["chatbot", "contact_form"] }
      },
      "required": ["name", "phone", "businessName", "websiteType", "timestamp"]
    }
  },
  "firestore": {
    "/leads/{leadId}": {
      "schema": "Lead",
      "description": "Collection of business leads"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Collection of portfolio projects"
    },
    "/siteContent/{docId}": {
      "schema": "SiteContent",
      "description": "Document for general site content"
    },
    "/admins/{userId}": {
      "schema": {
        "type": "object",
        "properties": {
          "email": { "type": "string" }
        }
      },
      "description": "List of admin users"
    }
  }
}
