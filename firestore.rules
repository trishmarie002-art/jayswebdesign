rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Projects Rules
    match /projects/{projectId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(projectId) && isValidProject(incoming());
      allow update: if isAdmin() && isValidProject(incoming());
      allow delete: if isAdmin();
    }

    function isValidProject(data) {
      return data.name is string && data.name.size() <= 200 &&
             data.url is string && data.url.size() <= 2000 &&
             data.image is string && data.image.size() <= 2000 &&
             data.category is string && data.category.size() <= 100 &&
             (data.get('alt', '') is string && data.get('alt', '').size() <= 2000) &&
             (data.get('order', 0) is number);
    }

    // Site Content Rules
    match /siteContent/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admins Rules
    match /admins/{userId} {
      // Allow the master admin or existing admins to manage the list
      allow read, write: if isAdmin();
      
      // Allow the specific user to bootstrap themselves. 
      // For higher security, restrict this to an email, e.g. && request.auth.token.email == "garzatricia89@gmail.com"
      allow write: if isSignedIn() && request.auth.uid == userId;
      
      // Allow user to check their own status
      allow read: if isSignedIn() && request.auth.uid == userId;
    }

    // Leads Rules
    match /leads/{leadId} {
      allow create: if isValidId(leadId) && isValidLead(incoming());
      allow read, update, delete: if isAdmin();
    }

    function isValidLead(data) {
      return (data.name is string && data.name.size() <= 200) &&
             (data.phone is string && data.phone.size() <= 200) &&
             (data.businessName is string && data.businessName.size() <= 200) &&
             (data.websiteType is string && data.websiteType.size() <= 200) &&
             (data.get('email', '') is string && data.get('email', '').size() <= 200) &&
             (data.get('projectDescription', '') is string && data.get('projectDescription', '').size() <= 2000) &&
             (data.get('website', '') is string && data.get('website', '').size() <= 500) &&
             data.timestamp is string &&
             data.source in ['chatbot', 'contact_form'];
    }
  }
}
